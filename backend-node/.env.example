# Konfigurasi Port Server
PORT=3000

# Google Gemini API Key (Dapatkan di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Nama Model Gemini (Sesuai rancangan arsitektur: gemini-2.5-pro atau gemini-1.5-pro / gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-pro

# Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
